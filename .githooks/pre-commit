#!/bin/sh
# 趣AI味 · 提交门槛（pre-commit）
#
# 背景：2026-09-14 排查发现 HEAD 长期处于不可构建状态——两个编译错误
# （llm-humanize 漏 import、llm.ts 字段名错）加上一个从未提交的新模块
# （judge-panel.ts），导致「干净 clone 后无法构建」。而 CI 里明明配了
# `tsc -b`，说明它并没有实际拦住——提交时没验证，是最上游的漏洞。
#
# 本 hook 只做一件最低限度的事：提交前确认类型检查通过（实测约 7 秒）。
#
# 紧急跳过：git commit --no-verify   （不建议——那正是坏 HEAD 的来源）

# 2026-09-14 补充：优先直调 tsc 的真实入口（node + tsc.js），
# 不走 ./node_modules/.bin/tsc —— 那个 wrapper 依赖 sed/dirname/uname，
# 在某些受限 shell（PATH 未初始化）下会 "command not found" 而假失败。
if command -v node >/dev/null 2>&1 && [ -f "./node_modules/typescript/bin/tsc" ]; then
  TSC="node ./node_modules/typescript/bin/tsc"
elif [ -x "./node_modules/.bin/tsc" ]; then
  TSC="./node_modules/.bin/tsc"
else
  TSC="npx tsc"
fi

# ── 密钥形态拦截（先跑，秒级）────────────────────────────────────────────
# 起因：scripts/archive/gateway-probe.mjs 在归档时把 3 条**可用的** SenseNova Key 硬编码
# 进文件并被 git 跟踪（34792ea），等于悄悄撤销了 54c12ce 的「Key 移出源码」。当时没有任何
# 环节拦得住——类型检查、单测、scan-bugs 都不看这个。这里只查本次暂存的新增行，
# 不让历史存量把仓库永久锁死；命中内容一律截断隐去，避免密钥被打进终端/CI 日志。
SECRET_RE='sk-[A-Za-z0-9]{16,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{24,}\.[A-Za-z0-9_-]{16,}\.'
if command -v git >/dev/null 2>&1; then
  hits=$(git diff --cached -U0 | grep -E "^\+" | grep -E "$SECRET_RE" | sed -E 's/^(\+.{0,14}).*/\1…（已隐去）/')
  if [ -n "$hits" ]; then
    printf '\n'
    echo "❌ 疑似密钥被写进提交内容，提交已阻止："
    echo "$hits"
    echo "   → 密钥走环境变量（SENSENOVA_KEYS）或 gitignore 的文件（scripts/.sensenova-keys）"
    echo "   → 注意 git 历史会永久留存明文：一旦推到远端就等于泄露，须先在控制台轮换"
    echo "   → 确属误报再跳过：git commit --no-verify"
    exit 1
  fi
fi

# ── 凭证账本 append-only（只在账本被碰过时才跑，不给普通提交加 tsx 启动开销）──────
# 起因：evidence/zhuque/ledger.jsonl 的全部价值是"历史行不会被动"，而 zhuque-evidence.ts
# 的 audit 只查得到字段对不上的篡改——删整行、重排、改不参与复算的自由文本字段它都看不见。
# 判据取最强的一条：HEAD 的每一行必须按原顺序原样出现在新内容开头，只许往后追加。
LEDGER_REL="evidence/zhuque/ledger.jsonl"
if command -v git >/dev/null 2>&1 && git diff --cached --name-only | grep -q "^${LEDGER_REL}\$"; then
  if command -v npx >/dev/null 2>&1; then
    echo "[pre-commit] 凭证账本 append-only 检查…"
    if ! npx tsx scripts/check-ledger-appendonly.ts --staged; then
      printf '\n'
      echo "❌ 凭证账本的历史行被动过了，提交已阻止。"
      echo "   → 要更正一条记录请**追加**一条新记录，让 audit 的 pct-conflict 去暴露矛盾"
      echo "   → 确属误报：git commit --no-verify"
      exit 1
    fi
    echo "[pre-commit] ✅ 凭证账本只追加了，历史一字未动"
  else
    printf '\n'
    echo "⚠️  [pre-commit] 环境缺少 npx，凭证账本 append-only 检查已跳过（未验证！）"
    echo "   → 请手动确认：npx tsx scripts/check-ledger-appendonly.ts --staged"
  fi
fi

echo "[pre-commit] 类型检查中…（约 7 秒）"
$TSC --noEmit
rc=$?
if [ $rc -ne 0 ]; then
  # 区分「工具链跑不起来」与「真有类型错误」：后者才该拦提交。
  # 工具链缺失属于环境问题，放行并醒目提示，避免误挡。
  if command -v node >/dev/null 2>&1; then
    printf '\n'
    echo "❌ 类型检查未通过，提交已阻止。"
    echo "   → 修掉上面的报错后重试"
    echo "   → 确需跳过：git commit --no-verify"
    exit 1
  fi
  printf '\n'
  echo "⚠️  [pre-commit] 环境缺少 node，类型检查已跳过（未验证！）"
  echo "   → 请手动确认：node node_modules/typescript/bin/tsc --noEmit"
  exit 0
fi
echo "[pre-commit] ✅ 类型检查通过"
exit 0
