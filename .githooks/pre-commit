#!/bin/sh
# 趣AI味 · 提交门槛（pre-commit）
#
# 背景：2026-09-14 排查发现 HEAD 长期处于不可构建状态——两个编译错误
# （llm-humanize 漏 import、llm.ts 字段名错）加上一个从未提交的新模块
# （judge-panel.ts），导致「干净 clone 后无法构建」。而 CI 里明明配了
# `tsc -b`，说明它并没有实际拦住——提交时没验证，是最上游的漏洞。
#
# 本 hook 只做一件最低限度的事：提交前确认类型检查通过（实测约 7 秒）。
#
# 紧急跳过：git commit --no-verify   （不建议——那正是坏 HEAD 的来源）

# git 执行 hook 时的 PATH 可能不含 node，做两级兜底
if [ -x "./node_modules/.bin/tsc" ]; then
  TSC="./node_modules/.bin/tsc"
else
  TSC="npx tsc"
fi

echo "[pre-commit] 类型检查中…（约 7 秒）"
if ! $TSC --noEmit; then
  printf '\n'
  echo "❌ 类型检查未通过，提交已阻止。"
  echo "   → 修掉上面的报错后重试"
  echo "   → 确需跳过：git commit --no-verify"
  exit 1
fi
echo "[pre-commit] ✅ 类型检查通过"
exit 0
